DATABASE_URL=postgresql://postgres:change-me@localhost:5432/audio_transcriber_db

JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
REQUIRE_AUTH=true

ASR_ENGINE=whisper
WHISPER_MODEL_NAME=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=ru
WHISPER_BEAM_SIZE=5

TASK_CLASSIFIER_ENGINE=rubert
RUBERT_TASK_MODEL=cointegrated/rubert-tiny2
RUBERT_CLASSIFIER_PATH=models/rubert_classifier

SENTIMENT_ENGINE=rule_based
RUBERT_SENTIMENT_MODEL=seara/rubert-tiny2-russian-sentiment

SPLIT_TRANSCRIPT_SEGMENTS=1
MAX_SEGMENT_WORDS=45
MIN_SEGMENT_CHARS=4

TOPIC_MODEL_ENGINE=auto
TOPIC_MODELING_ENGINE=auto
TOPIC_MIN_FRAGMENTS=8
TOPIC_MAX_TOPICS=12
TOPIC_MODEL_PATH=models/topic_model
TOPIC_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
BERTOPIC_MODEL_PATH=models/topic_model
BERTOPIC_MIN_TOPIC_SIZE=3
BERTOPIC_LANGUAGE=multilingual
ENABLE_MODEL_FALLBACK=true

UPLOAD_DIR=uploads
RESULTS_DIR=results

# UI
UI_THEME=light_monochrome

# Feedback learning
AUTO_RETRAIN=false
MIN_FEEDBACK_EXAMPLES_FOR_RETRAIN=50
FEEDBACK_DATASET_PATH=datasets/sources/feedback_examples.jsonl
RUBERT_CANDIDATE_PATH=models/rubert_classifier_candidate

# Optional async processing. Keep false for local sync flow.
ASYNC_PROCESSING=false
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
